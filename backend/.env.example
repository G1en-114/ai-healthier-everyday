# 第三方服务凭证 —— 仅占位示例，切勿填入真实密钥并提交到版本控制。
# 复制为 .env 并填入真实值后本地使用；.env 已在 .gitignore 中忽略。

DATABASE_URL=sqlite:///./dev.db

# ---- AI Healthier Every Day 模型服务 ----
# 全部能力「未配置自动降级」：不配也能启动（桩 + 模板兜底），服务永不 5xx。

# LLM 自我照护 Agent（OpenAI 兼容协议）。
# 推荐腾讯云混元（Tencent Cloud Hunyuan，OpenAI 兼容端点，本赛事官方 AI 栈）：
#   LLM_API_BASE=https://api.hunyuan.cloud.tencent.com/v1
#   LLM_MODEL=hunyuan-turbos-latest
# 其他 OpenAI 兼容端点（Qwen DashScope/DeepSeek/GLM/Ollama 等）换这三项即可。
LLM_API_BASE=https://api.hunyuan.cloud.tencent.com/v1
LLM_API_KEY=
LLM_MODEL=hunyuan-turbos-latest

# 多模态视觉顾问（OpenAI 兼容协议，可选；示例为混元多模态 / Qwen-VL）
VLM_API_BASE=https://api.hunyuan.cloud.tencent.com/v1
VLM_API_KEY=
VLM_MODEL=hunyuan-vision

# 自研 ST-GCN 动作识别（需健康的 torch+numpy 环境；个别环境加载会原生崩溃，
# 故默认关闭，确认环境健康后置 1）
ENABLE_STGCN=0
STGCN_CHECKPOINT=model/bestbest/best_model_2.pth

# 模型服务鉴权与计量：逗号分隔的合法 API-key 列表；留空 = 开发模式放行
# （/api/status 标注 disabled-dev；对外演示前务必配置）
MODEL_SERVICE_API_KEYS=
MODEL_SERVICE_DB=model_usage.db
